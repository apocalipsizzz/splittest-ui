{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node", "vitest/globals"],

    /* Строгий режим: библиотека отдаёт типы наружу, ошибки типов здесь — ошибки у всех консьюмеров */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,

    /* Декларации генерирует tsdown, tsc используется только для typecheck */
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": false,

    /* `@/lib/cn` → `src/lib/cn`. Паттерн `@/*`, а не `@`, чтобы не перехватывать скоупы пакетов. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "scripts", ".storybook", "*.ts", "*.mjs"]
}
